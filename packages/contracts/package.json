{
  "name": "@avg/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical JSON Schemas for pipeline artifacts plus generated TypeScript types and Ajv validators.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "check": "node scripts/gen.mjs --check",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "eslint": "^9.34.0",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
