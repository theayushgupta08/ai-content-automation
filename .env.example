# Copy to .env for local development. All values below match docker-compose.yml.

# --- shared ---
NODE_ENV=development
DATABASE_URL=postgresql://avg:avg@localhost:5432/avg
REDIS_URL=redis://localhost:6379
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=video-jobs

# Shared secret between workers and the API's /internal endpoints
INTERNAL_API_TOKEN=dev-internal-token

# --- api ---
API_PORT=4000
API_URL=http://localhost:4000
# When true, requests without a Clerk JWT are treated as the dev workspace below.
DEV_AUTH=true
DEV_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
DEV_USER_ID=00000000-0000-0000-0000-000000000002

# --- media storage ---
# "local" writes to MEDIA_ROOT and serves via the API; "s3" uses S3_* below.
MEDIA_BACKEND=local
MEDIA_ROOT=./.local/media
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=avg-media
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_REGION=us-east-1

# --- workers ---
# "mock" synthesises fixture assets locally; "live" uses the first real adapter for each
# capability that has one (currently: llm=anthropic). Override one capability with
# PROVIDER_LLM / PROVIDER_IMAGE / PROVIDER_VIDEO / PROVIDER_SPEECH / PROVIDER_MUSIC / PROVIDER_SFX.
PROVIDER_MODE=mock
PROVIDER_LLM=
# Story engine models (Anthropic). The critic also runs input/script moderation.
ANTHROPIC_STORY_MODEL=claude-opus-5
ANTHROPIC_CRITIC_MODEL=claude-haiku-4-5
ANTHROPIC_EFFORT=medium
STORY_CRITIQUE=true
STORY_CRITIQUE_THRESHOLD=7
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# --- web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# Leave blank to run without Clerk (dev auth). Set both to enable Clerk.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- provider keys (unused when PROVIDER_MODE=mock) ---
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
FAL_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
RUNWAY_API_KEY=
