# Copy to .env for local development. All values below match docker-compose.yml.

# --- shared ---
NODE_ENV=development
DATABASE_URL=postgresql://avg:avg@localhost:5432/avg
REDIS_URL=redis://localhost:6379
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=video-jobs

# Shared secret between workers and the API's /internal endpoints
INTERNAL_API_TOKEN=dev-internal-token

# --- api ---
API_PORT=4000
API_URL=http://localhost:4000
# When true, requests without a Clerk JWT are treated as the dev workspace below.
DEV_AUTH=true
DEV_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
DEV_USER_ID=00000000-0000-0000-0000-000000000002

# --- media storage ---
# "local" writes to MEDIA_ROOT and serves via the API; "s3" uses S3_* below.
MEDIA_BACKEND=local
MEDIA_ROOT=./.local/media
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=avg-media
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_REGION=us-east-1
# Host browsers should use for presigned URLs when S3_ENDPOINT is internal (e.g. minio:9000).
S3_PUBLIC_ENDPOINT=
# Workers: local cache for S3 objects (per pod, safe to wipe).
MEDIA_CACHE_DIR=/tmp/avg-media-cache

# --- workers ---
# "mock" synthesises fixture assets locally; "live" uses the first real adapter for each
# capability that has one (currently: llm=anthropic). Override one capability with
# PROVIDER_LLM / PROVIDER_IMAGE / PROVIDER_VIDEO / PROVIDER_SPEECH / PROVIDER_MUSIC / PROVIDER_SFX.
PROVIDER_MODE=mock
PROVIDER_LLM=
# Story engine models (Anthropic). The critic also runs input/script moderation.
ANTHROPIC_STORY_MODEL=claude-opus-5
ANTHROPIC_CRITIC_MODEL=claude-haiku-4-5
ANTHROPIC_EFFORT=medium
STORY_CRITIQUE=true
STORY_CRITIQUE_THRESHOLD=7
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# --- billing (Stripe) ---
# Leave STRIPE_SECRET_KEY blank to run without billing; every workspace still gets trial credits.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTH=
STRIPE_PRICE_STARTER_YEAR=
STRIPE_PRICE_CREATOR_MONTH=
STRIPE_PRICE_CREATOR_YEAR=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_STUDIO_MONTH=
STRIPE_PRICE_STUDIO_YEAR=
STRIPE_PRICE_PACK_500=
WEB_URL=http://localhost:3000

# --- web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# Leave blank to run without Clerk (dev auth). Set both to enable Clerk.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- fal.ai: images (Flux) and video (Kling, Wan, MiniMax) through one queue API ---
# Chains are comma-separated fal model ids tried in order; a shared circuit breaker
# (Redis-backed when REDIS_URL is set) skips a model after BREAKER_FAILURE_THRESHOLD
# failures in BREAKER_WINDOW_SEC for BREAKER_OPEN_SEC.
FAL_IMAGE_MODEL=fal-ai/flux-pro/v1.1
FAL_IMAGE_REFERENCE_MODEL=fal-ai/flux-pro/kontext
VIDEO_CHAIN_STANDARD=fal-ai/kling-video/v2.1/standard/image-to-video,fal-ai/wan-i2v
VIDEO_CHAIN_PREMIUM=fal-ai/kling-video/v2.1/pro/image-to-video,fal-ai/kling-video/v2.1/standard/image-to-video
BREAKER_FAILURE_THRESHOLD=5
BREAKER_WINDOW_SEC=60
BREAKER_OPEN_SEC=60

# --- ElevenLabs: speech with word timestamps, sound effects, generated music ---
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# JSON map of voice alias -> ElevenLabs voice id, e.g. {"narrator":"21m00Tcm4TlvDq8ikWAM"}
ELEVENLABS_VOICES=
# Music: "elevenlabs,library" tries generated music first, then the curated library.
MUSIC_CHAIN=elevenlabs,library
MUSIC_LIBRARY_DIR=./media/music-library

# --- provider keys (unused when PROVIDER_MODE=mock) ---
ANTHROPIC_API_KEY=
FAL_KEY=
ELEVENLABS_API_KEY=
