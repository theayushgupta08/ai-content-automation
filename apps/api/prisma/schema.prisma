// Phase 0 schema: identity, tenancy, jobs and pipeline state.
// Billing (plans, subscriptions, ledger), characters, voices and webhooks follow in Phase 1
// per docs/04-data-model.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  externalId String   @unique @map("external_id")
  email      String   @unique
  name       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  memberships WorkspaceMember[]
  jobs        VideoJob[]

  @@map("users")
}

model Workspace {
  id                  String    @id @default(uuid()) @db.Uuid
  slug                String    @unique
  name                String
  ownerId             String    @map("owner_id") @db.Uuid
  settings            Json      @default("{}")
  /// Set by the owner's deletion request; the purge job hard-deletes after the grace period.
  deletionRequestedAt DateTime? @map("deletion_requested_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  members       WorkspaceMember[]
  jobs          VideoJob[]
  subscriptions Subscription[]
  ledger        CreditLedger[]
  holds         CreditHold[]
  balance       CreditBalance?
  notifications Notification[]

  @@map("workspaces")
}

enum MemberRole {
  owner
  admin
  editor
  viewer
}

model WorkspaceMember {
  workspaceId String     @map("workspace_id") @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  role        MemberRole @default(editor)
  createdAt   DateTime   @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@map("workspace_members")
}

enum JobStatus {
  queued
  running
  awaiting_approval
  completed
  failed
  canceled
  needs_review
}

enum JobStage {
  moderation
  story
  characters
  keyframes
  video
  audio
  edit
  final
}

model VideoJob {
  id                 String    @id @default(uuid()) @db.Uuid
  workspaceId        String    @map("workspace_id") @db.Uuid
  createdBy          String    @map("created_by") @db.Uuid
  status             JobStatus @default(queued)
  currentStage       JobStage? @map("current_stage")
  /// Normalised JobInput contract (prompt, characters, options).
  input              Json
  pipelineVersion    String    @default("v0") @map("pipeline_version")
  temporalWorkflowId String?   @unique @map("temporal_workflow_id")
  title              String?
  durationSec        Float?    @map("duration_sec")
  sceneCount         Int?      @map("scene_count")
  estimatedCredits   Int       @map("estimated_credits")
  actualCredits      Int?      @map("actual_credits")
  creditsHeld        Int       @default(0) @map("credits_held")
  /// Estimated provider spend summed from artifact metadata at completion (internal only).
  actualCostUsd      Decimal?  @map("actual_cost_usd") @db.Decimal(10, 4)
  /// Storage keys of deliverables: {mp4Key, previewKey, srtKey, vttKey, thumbKey, posterKey}.
  output             Json?
  flags              String[]  @default([])
  error              Json?
  startedAt          DateTime? @map("started_at")
  completedAt        DateTime? @map("completed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id])
  creator   User       @relation(fields: [createdBy], references: [id])
  scenes    Scene[]
  artifacts Artifact[]
  events    JobEvent[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([status])
  @@map("video_jobs")
}

enum SceneStatus {
  pending
  keyframes
  video
  audio
  done
  failed
  fallback
}

model Scene {
  id            String      @id @default(uuid()) @db.Uuid
  jobId         String      @map("job_id") @db.Uuid
  idx           Int
  status        SceneStatus @default(pending)
  plan          Json?
  plannedSec    Float?      @map("planned_sec")
  actualSec     Float?      @map("actual_sec")
  attempts      Json        @default("{}")
  providerVideo String?     @map("provider_video")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  job VideoJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, idx])
  @@map("scenes")
}

model Artifact {
  id          String   @id @default(uuid()) @db.Uuid
  jobId       String   @map("job_id") @db.Uuid
  sceneIndex  Int?     @map("scene_index")
  kind        String
  storageKey  String   @map("storage_key")
  contentType String?  @map("content_type")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  job VideoJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, storageKey])
  @@index([jobId, kind])
  @@map("artifacts")
}

model JobEvent {
  id        BigInt   @id @default(autoincrement())
  jobId     String   @map("job_id") @db.Uuid
  seq       Int
  type      String
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  job VideoJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, seq])
  @@map("job_events")
}

// ---- Billing ------------------------------------------------------------------------

model Plan {
  id               String  @id
  name             String
  stripePriceMonth String? @map("stripe_price_month")
  stripePriceYear  String? @map("stripe_price_year")
  creditsPerPeriod Int     @map("credits_per_period")
  maxDurationSec   Int     @map("max_duration_sec")
  maxConcurrency   Int     @map("max_concurrency")
  maxResolution    String  @map("max_resolution")
  /// {premiumVideo, directorMode, api, voiceClone, seats, watermark, priorityQueue}
  features         Json
  rolloverMonths   Int     @default(0) @map("rollover_months")
  priceUsdMonth    Int     @default(0) @map("price_usd_month")
  active           Boolean @default(true)

  subscriptions Subscription[]

  @@map("plans")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  unpaid
  paused
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  workspaceId          String             @map("workspace_id") @db.Uuid
  planId               String             @map("plan_id")
  stripeCustomerId     String             @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  status               SubscriptionStatus
  currentPeriodStart   DateTime           @map("current_period_start")
  currentPeriodEnd     DateTime           @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  plan      Plan      @relation(fields: [planId], references: [id])

  @@index([workspaceId, status])
  @@map("subscriptions")
}

enum LedgerReason {
  trial_grant
  subscription_grant
  rollover
  pack_purchase
  job_hold
  job_settle
  job_refund
  regen_charge
  manual_adjustment
  expiry
  promo
}

/// Append-only. Balance = sum(amount). Rows are never updated or deleted.
model CreditLedger {
  id             BigInt       @id @default(autoincrement())
  workspaceId    String       @map("workspace_id") @db.Uuid
  amount         Int
  reason         LedgerReason
  jobId          String?      @map("job_id") @db.Uuid
  holdId         String?      @map("hold_id") @db.Uuid
  expiresAt      DateTime?    @map("expires_at")
  metadata       Json         @default("{}")
  idempotencyKey String?      @unique @map("idempotency_key")
  createdAt      DateTime     @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("credit_ledger")
}

enum HoldStatus {
  active
  settled
  released
}

model CreditHold {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  jobId       String     @unique @map("job_id") @db.Uuid
  estimated   Int
  spent       Int        @default(0)
  status      HoldStatus @default(active)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@map("credit_holds")
}

/// Materialised balance, updated inside the same transaction as every ledger row.
model CreditBalance {
  workspaceId String   @id @map("workspace_id") @db.Uuid
  available   Int      @default(0)
  held        Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@map("credit_balances")
}

model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("stripe_events")
}

enum NotificationStatus {
  sent
  failed
  skipped
}

/// Every lifecycle email we tried to send. `dedupeKey` makes each trigger fire at most once
/// (welcome per user, video_ready per job, low_credits per billing period, ...).
model Notification {
  id          String             @id @default(uuid()) @db.Uuid
  workspaceId String             @map("workspace_id") @db.Uuid
  userId      String?            @map("user_id") @db.Uuid
  kind        String
  dedupeKey   String             @unique @map("dedupe_key")
  recipient   String
  subject     String
  status      NotificationStatus
  error       String?
  createdAt   DateTime           @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, createdAt])
  @@map("notifications")
}
